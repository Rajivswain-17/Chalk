# ============================================================================
# Chalk — .env (development, DO NOT COMMIT real keys)
# ----------------------------------------------------------------------------
# Loaded by docker-compose.yml via `env_file: .env` into the server service,
# and validated at boot by server/src/lib/env.ts (Zod).
# Hostnames `postgres` / `valkey` are Docker DNS names (see compose file).
# For running the server OUTSIDE Docker, replace them with `localhost`.
# ============================================================================

# --- Server -----------------------------------------------------------------
# Express listen port. Must match Dockerfile EXPOSE + compose ports mapping.
PORT=3001
# development | production | test. Enables stack traces, hot-reload, verbose logs.
NODE_ENV=development

# --- Database (PostgreSQL + Drizzle ORM) ------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB
# HOST=postgres inside Docker, localhost outside Docker.
DATABASE_URL="postgresql://chalk:chalk@postgres:5432/chalk"

# --- Valkey / Redis (BullMQ queue + SSE pub/sub) ----------------------------
# Format: redis://HOST:PORT  (Valkey speaks the Redis protocol).
# HOST=valkey inside Docker, localhost outside Docker.
REDIS_URL="redis://valkey:6379"

# --- OpenAI (agents: planner → scriptwriter → sceneDesigner) -----------------
# Needs access to structured JSON outputs (response_format: json_schema).
OPENAI_API_KEY="your_openai_api_key_here"

# --- ElevenLabs (TTS + word timestamps) --------------------------------------
# Voice used by services/voice/elevenlabs.ts. Default below is Rachel.
ELEVENLABS_API_KEY="your_elevenlabs_api_key_here"
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"

# --- Paths (inside the container) --------------------------------------------
# OUTPUT_DIR: final MP4 + HLS output (playlist.m3u8 + seg_001.ts...).
#   Served by Express as /hls/:videoId/*.
# ICON_CACHE_DIR: disk cache for Iconify API fallback SVGs so renders are
#   offline-safe and repeat builds never re-fetch the same icon.
OUTPUT_DIR="/app/output"
ICON_CACHE_DIR="/app/cache/icons"
