# ============================================================================
# Chalk — .env.example (safe to commit, contains NO secrets)
# ----------------------------------------------------------------------------
# Copy to `.env` to bootstrap local dev: `cp .env.example .env`
# then fill in OPENAI_API_KEY + ELEVENLABS_API_KEY.
# Every key here MUST stay in sync with `.env` and server/src/lib/env.ts.
# ============================================================================

# --- Server -----------------------------------------------------------------
# Express listen port (Dockerfile EXPOSE + compose ports must match).
PORT=3001
# Use development for hot-reload; production for optimized builds.
NODE_ENV=development

# --- Database (PostgreSQL + Drizzle ORM) ------------------------------------
# Local Docker default. Outside Docker use localhost instead of postgres.
# Example: postgresql://chalk:chalk@localhost:5432/chalk
DATABASE_URL="postgresql://chalk:chalk@postgres:5432/chalk"

# --- Valkey / Redis (BullMQ queue + SSE pub/sub) ----------------------------
# Local Docker default. Outside Docker use localhost instead of valkey.
# Example: redis://localhost:6379
REDIS_URL="redis://valkey:6379"

# --- OpenAI (agents: planner → scriptwriter → sceneDesigner) -----------------
# Get one from https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# --- ElevenLabs (TTS + word timestamps) --------------------------------------
# Get one from https://elevenlabs.io — default voice below is Rachel.
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"

# --- Paths (inside the container) --------------------------------------------
# Rendered MP4 + HLS segments. Must match the storage volume in compose.
OUTPUT_DIR="/app/output"
# Disk cache for Iconify fallback SVGs (avoids repeat network fetches).
ICON_CACHE_DIR="/app/cache/icons"
